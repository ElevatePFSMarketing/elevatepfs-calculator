# --- Browser (safe to be public; compiled into the site) ---
# Your Google Tag Manager container. Leave blank to disable analytics.
VITE_GTM_ID=

# --- Server only: set these in Netlify > Site configuration > Environment variables.
# --- NEVER prefix with VITE_ and never commit real values. ---
# Long random string used to sign "unlocked" tokens (e.g. run: openssl rand -hex 32)
GATE_SECRET=
# Salesforce org ID from Setup > Web-to-Lead
SF_OID=
# Optional
SF_WEBTOLEAD_URL=
SF_LEAD_SOURCE=Web
SF_CAMPAIGN_ID=
SF_CUSTOM_FIELDS=
